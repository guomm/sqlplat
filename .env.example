# 平台元数据库。密码中的特殊字符需要 URL 编码。
DATABASE_URL=mysql+pymysql://sqlplat:replace-with-strong-password@127.0.0.1:3306/sqlplat?charset=utf8mb4
# 生成命令见 README；不能丢失或随意更换。
ENCRYPTION_KEY=replace-with-generated-fernet-key
RESULT_DIR=.local/results
# 本机 HTTP 试用设置 false；正式部署 HTTPS 设置 true。
COOKIE_SECURE=false
EXECUTION_WORKERS=4
EXECUTION_QUEUE=20
EXECUTION_TIMEOUT=300
RESULT_ROWS=100000
PREVIEW_ROWS=1000
RESULT_BYTES=104857600
RESULT_HOURS=24
HISTORY_DAYS=90
SESSION_HOURS=12
